thoughtrecipe multi_step_capture
"Multi-step workflow demonstrating capture and carry-forward context."

trigger as capability:
  may read workspace

input workspace: "**/*"

type ReviewFindings:
  summary: Markdown
  complexity: low | medium | high

agent explorer uses euclo
agent reviewer uses react

run explorer:
  from input.workspace
  goal "Explore the workspace."
  capture:
    explored_files -> state.explored_files

run reviewer:
  from state.explored_files
  goal "Review the explored workspace."
  capture:
    analysis_result -> state.analysis_result
