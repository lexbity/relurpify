thoughtrecipe euclo.thoughtrecipe.extract_func
"Refactor-family recipe for function extraction: perform the extraction in a react edit pass, then verify through the workspace's test runner tools. Family defaults: edits confined to the extraction; verification runs through the runner tools before completion."

trigger as capability:
  may read workspace
  may write workspace
  may invoke ["file_read", "file_search"]
  family ["refactor"]

input workspace: "**/*"
input prompt: user.request

agent refactorer uses react

run refactorer:
  may invoke ["file_read", "file_search", "file_write", "python_pytest", "python_unittest", "go_test", "node_npm_test", "rust_cargo_test"]
  from input.prompt
  goal """Extract the requested code into its own function, then verify the build and tests still pass with the matching test runner tool. The user request is: {{ index . "task.instruction" }}"""
  capture result -> state.refactor
