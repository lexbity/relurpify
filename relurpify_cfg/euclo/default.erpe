thoughtrecipe euclo.thoughtrecipe.default
"Canonical default execution recipe: clarify-first intake, then one react run bounded to the workspace. Family defaults: edits go through governed file_write; edits are verified through the workspace's test runner tools before completion."

trigger as capability:
  may read workspace
  may write workspace
  may invoke ["file_read", "file_list", "file_search"]
  family ["review", "investigation", "debug", "migration", "implementation", "refactor", "architecture"]

input workspace: "**/*"
input prompt: user.request

agent worker uses react

run worker:
  may invoke ["file_read", "file_list", "file_search", "file_write", "python_pytest", "python_unittest", "go_test", "node_npm_test", "rust_cargo_test"]
  from input.prompt
  goal """Complete the user's task against the workspace. When the task edits code, verify the change by running the test runner tool that matches the project before reporting complete. The user request is: {{ index . "task.instruction" }}"""
  capture result -> state.summary
