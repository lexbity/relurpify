thoughtrecipe euclo.thoughtrecipe.code_review
"Review-family recipe: gather the diff and surrounding context, then run a react review pass that produces findings with severity and suggested actions. Family defaults: read-only; no writes."

trigger as capability:
  may read workspace
  may invoke ["file_read", "file_search"]
  family ["review"]

input workspace: "**/*"
input prompt: user.request

agent reviewer uses react

run reviewer:
  may invoke ["file_read", "file_search"]
  from input.workspace
  goal "Review the pending changes and produce findings with severity and suggested actions."
  capture result -> state.findings
