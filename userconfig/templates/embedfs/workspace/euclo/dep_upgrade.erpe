thoughtrecipe euclo.thoughtrecipe.dep_upgrade
"Migration-family recipe for dependency upgrades: locate the manifest, apply the upgrade with writes confined to the upgrade run, then verify with the test suite through the workspace's test runner tools. Family defaults: the upgrade is HITL-gated; the runner tools must pass before the upgrade is reported complete."

trigger as capability:
  may read workspace
  may write workspace
  may invoke ["file_read", "file_search"]
  family ["migration"]

input workspace: "**/*"
input prompt: user.request

agent upgrader uses react

run upgrader:
  may invoke ["file_read", "file_search", "file_write", "python_pytest", "python_unittest", "go_test", "node_npm_test", "rust_cargo_test"]
  from input.workspace
  goal """Locate the dependency manifest, apply the requested upgrade, and run the test suite with the matching test runner tool to verify it. The user request is: {{ index . "task.instruction" }}"""
  capture result -> state.upgrade
